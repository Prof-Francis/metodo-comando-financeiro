---
interface Props {
	label: string;
	title: string;
	description: string;
	cta: string;
	href: string;
	featured?: boolean;
}

const { label, title, description, cta, href, featured = false } = Astro.props;
---

<a class:list={['home-link-card', { featured }]} href={href}>
	<span class="card-meta">
		<span>{label}</span>
	</span>
	<span class="card-content">
		<strong>{title}</strong>
		<span>{description}</span>
	</span>
	<span class="card-cta">
		{cta}
		<span aria-hidden="true">↗</span>
	</span>
</a>
